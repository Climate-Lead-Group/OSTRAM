__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/
.pytest_cache/
.env
.venv/
venv/
/build/
/dist/
/*.egg-info/

# Local tool metadata and DVC runtime state.
.claude/
.dvc/cache/
.dvc/tmp/

# OS and editor state.
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Local presentation and guide artifacts.
*.twbx
workflow.pptx
OSTRAM_Guia_instalacion_ejecucion.pdf

# Raw/candidate regression artifacts; compact baselines remain tracked.
tests/regression/artifacts/
tests/regression/candidates/

