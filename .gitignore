# ===== Per-scenario solve I/O (regenerable; keep repo lean) =====
# otoole result CSVs, per-scenario concatenations, compiled datafiles and logs.
# (*.lp / *.sol / *StorageDelay* / OSTRAM_Combined_* already ignored above.)
t1_confection/Executables/**/Outputs/
t1_confection/Executables/**/*_Input.csv
t1_confection/Executables/**/*_Output.csv
t1_confection/Executables/**/*.warnings.txt
t1_confection/Executables/**/*.cplex.log
t1_confection/Executables/**/Pre_processed_*.txt
t1_confection/Executables/*/*_0.txt

# ===== Timestamped pre-edit backup snapshots (regenerable; never commit) =====
# apply_patches / base-year-pin / interconnector-direction / v18 edits drop *_PRE*_<timestamp>
# copies beside their target. Regenerable safety nets — keep them local, never in the repo.
t1_confection/A1_Outputs/*_PREPATCH_*
t1_confection/A1_Outputs/*_PRE_*
t1_confection/A3_process/SOASIA_OSeMOSYS_Template_v18_PRE_*.xlsx

# Timestamped sensitivity patch audit records are reproducible. Existing
# tracked records remain historical evidence; ignore only new generated ones.
t1_confection/A1_Outputs/**/apply_patches_CHANGES_*.json

# Raw/candidate regression artifacts stay outside Git; compact baselines under
# tests/regression/baselines/ remain tracked.
tests/regression/artifacts/
tests/regression/candidates/
